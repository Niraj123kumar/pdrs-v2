# Copy to .env and fill in values.

# HTTP port the Express server listens on.
PORT=3000

# Path to the SQLite database file.
DB_PATH=./data/pdrs.db

# Secret used to sign JWT access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Groq API key (used by later phases for AI generation / evaluation).
GROQ_API_KEY=

# Comma-separated list of allowed CORS origins (leave blank for same-origin only).
ALLOWED_ORIGINS=

# bcrypt work factor used for password hashing and seed accounts.
BCRYPT_ROUNDS=10
